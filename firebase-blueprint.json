  "firestore": {
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Documento raíz del espacio de gestión Bonus Ticket por propietario."
    },
    "/workspaces/{workspaceId}/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Empresas activas, prospectos, bajas y otros en Tucumán con datos de difusión y facturación."
    },
    "/workspaces/{workspaceId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Carteles de tareas semanales y acuerdos de reuniones de los lunes."
    },
    "/workspaces/{workspaceId}/planTasks/{planTaskId}": {
      "schema": { "$ref": "#/entities/PlanTask" },
      "description": "Tablero Kanban de Planificación Semanal (Reuniones de Lunes) organizado por sector y semana."
    },
    "/workspaces/{workspaceId}/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Cobranzas mensuales vinculadas a empresas activas."
    },
    "/workspaces/{workspaceId}/metaReports/{reportId}": {
      "schema": { "$ref": "#/entities/MetaReport" },
      "description": "Reportes de redes Meta Business Suite (CSV y Gemini Vision)."
    },
    "/workspaces/{workspaceId}/marketingLogs/{logId}": {
      "schema": { "$ref": "#/entities/MarketingLog" },
      "description": "Bitácora semanal de Marketing y entregas de kits/reels por empresa."
    },
    "/workspaces/{workspaceId}/fidelizaciones/{fidelizacionId}": {
      "schema": { "$ref": "#/entities/Fidelizacion" },
      "description": "Registro de fidelizaciones con empresas sincronizadas con Planificación Semanal."
    },
    "/workspaces/{workspaceId}/companyActivities/{activityId}": {
      "schema": { "$ref": "#/entities/CompanyActivity" },
      "description": "Historial de actividades y movimientos relevantes de empresas."
    },
    "/workspaces/{workspaceId}/cobranzaEvents/{eventId}": {
      "schema": { "$ref": "#/entities/CobranzaEvent" },
      "description": "Agenda e historial de pagos parciales, cambios de tarifa, lotes y compromisos de cobranza."
